@model WebApplication_Lab1_Wan.Models.GradeModel

@{
    ViewData["Title"] = "Grade Calculator";
}

<div class="container mt-3">
    <h2>Grade Calculator</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Index" method="post">
                <div class="form-group mb-3">
                    <label class="control-label">Name:</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Test (/25):</label>
                    <input asp-for="Test" type="number" class="form-control" step="any" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Assignment (/50):</label>
                    <input asp-for="Assignment" type="number" class="form-control" step="any" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Project (/75):</label>
                    <input asp-for="Project" type="number" class="form-control" step="any" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Final Exam (/100):</label>
                    <input asp-for="FinalExam" type="number" class="form-control" step="any" required />
                </div>

                <div class="form-group">
                    <input type="submit" value="Calculate" class="btn btn-success" />
                </div>
            </form>
        </div>

        <div class="col-md-6">
            @if (Model != null && Model.OverallMark.HasValue)
            {
                <div class="card p-4 bg-light shadow-sm">
                    <h4>Result</h4>
                    <hr />
                    <p><strong>Name:</strong> @Model.Name</p>
                    <p><strong>Overall mark (/100):</strong> <span class="text-success fw-bold">@Model.OverallMark.Value.ToString("F2")</span></p>
                    <p><strong>Grade:</strong> <span class="text-success fw-bold">@Model.Grade</span></p>
                </div>
            }
        </div>
    </div>
</div>
