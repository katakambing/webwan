@model WebApplication_Lab1_Wan.Models.GradeModel

@{
    ViewData["Title"] = "Grade Calculator";
}

<form asp-action="Index" method="post">
    <p>
        Name: <input asp-for="Name" required />
    </p>
    <p>
        Test (/25): <input asp-for="Test" type="number" step="any" required />
    </p>
    <p>
        Assignment (/50): <input asp-for="Assignment" type="number" step="any" required />
    </p>
    <p>
        Project (/75): <input asp-for="Project" type="number" step="any" required />
    </p>
    <p>
        Final Exam (/100): <input asp-for="FinalExam" type="number" step="any" required />
    </p>
    <p>
        <input type="submit" value="Calculate" />
    </p>
</form>

@if (Model != null && Model.OverallMark.HasValue)
{
    <p>Overall mark (/100): @Model.OverallMark.Value.ToString("F2")</p>
    <p>Grade: @Model.Grade</p>
}
