@model WebApplication_Lab1_Wan.Models.ElectricityModel

@{
    ViewData["Title"] = "Electricity Bill Calculator";
}

<h2>Electricity Bill Calculator</h2>

<form method="post" asp-action="ElectricityView">
    <div class="mb-3">
        <label class="form-label">Units Consumed (kWh):</label>
        <input asp-for="UnitsConsumed" type="number" step="0.01" class="form-control" style="max-width: 350px;" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tariff Category:</label>
        <select asp-for="Category" class="form-select" style="max-width: 350px;">
            <option value="Domestic">Domestic (Residential)</option>
            <option value="Commercial">Commercial</option>
        </select>
    </div>
    <input type="submit" value="Calculate Bill" class="btn btn-primary" />
</form>

<br />
@if (Model != null)
{
    <div>
        <h3>Total Charges: RM @Model.TotalAmount.ToString("0.00")</h3>
    </div>
}
