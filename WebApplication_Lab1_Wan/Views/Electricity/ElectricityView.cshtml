@model WebApplication_Lab1_Wan.Models.ElectricityModel

<h3>Electricity Bill Calculator</h3>

<form asp-action="ElectricityView" method="post">
    <p>
        Previous reading:
        <input asp-for="previousReading" />
    </p>
    <p>
        Current reading:
        <input asp-for="currentReading" />
    </p>
    <p>
        <input type="submit" value="Calculate Bill" />
    </p>
</form>

<p>Previous reading: @(Model != null ? Model.previousReading.ToString() : "")</p>
<p>Current reading: @(Model != null ? Model.currentReading.ToString() : "")</p>

<table>
    <tr>
        <th>Tariff Block(kWh)</th>
        <th>Unit(kWh)</th>
        <th>Rate(RM)</th>
        <th>Amount(RM)</th>
    </tr>
    <tr>
        <td>Block 1: 0-300</td>
        <td>@(Model != null ? Model.usageBlock1.ToString() : "")</td>
        <td>0.30</td>
        <td>@(Model != null ? Model.chargeBlock1.ToString() : "")</td>
    </tr>
    <tr>
        <td>Block 2: 301-700</td>
        <td>@(Model != null ? Model.usageBlock2.ToString() : "")</td>
        <td>0.40</td>
        <td>@(Model != null ? Model.chargeBlock2.ToString() : "")</td>
    </tr>
    <tr>
        <td>Block 3: &gt;700</td>
        <td>@(Model != null ? Model.usageBlock3.ToString() : "")</td>
        <td>0.50</td>
        <td>@(Model != null ? Model.chargeBlock3.ToString() : "")</td>
    </tr>
    <tr>
        <td>Total</td>
        <td>@(Model != null ? Model.usage.ToString() : "")</td>
        <td></td>
        <td>@(Model != null ? Model.totalCharge.ToString() : "")</td>
    </tr>
</table>
