<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication_Lab1_Wan</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Lab 1 - Wan</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="BMI" asp-action="BMICalculator">BMI</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Temp" asp-action="TempView">Temperature</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Grade" asp-action="Index">Grade</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MCQ" asp-action="MCQView">MCQ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="FavouritePet" asp-action="FavouritePetView">Favourite Pet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Electricity" asp-action="ElectricityView">Electricity Bill</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - ISB 42403 Web Application Development (Lab 1)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
