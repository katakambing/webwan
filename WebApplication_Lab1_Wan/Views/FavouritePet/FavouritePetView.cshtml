<h3>Favourite Pet Application</h3>

<form asp-action="FavouritePetView" method="post">
    <p>
        Please select your favourite pet:<br /><br />
        <select name="pet" size="6" required>
            <option value="bird" selected="@(ViewBag.pet == "bird")">Bird</option>
            <option value="cat" selected="@(ViewBag.pet == "cat")">Cat</option>
            <option value="dog" selected="@(ViewBag.pet == "dog")">Dog</option>
            <option value="fish" selected="@(ViewBag.pet == "fish")">Fish</option>
            <option value="lizard" selected="@(ViewBag.pet == "lizard")">Lizard</option>
            <option value="rabbit" selected="@(ViewBag.pet == "rabbit")">Rabbit</option>
        </select>
    </p>

    <p>
        Select image size:<br /><br />
        <select name="size">
            <option value="50" selected="@(ViewBag.size == "50")">Extra Small</option>
            <option value="100" selected="@(ViewBag.size == "100")">Small</option>
            <option value="150" selected="@(ViewBag.size == null || ViewBag.size == "150")">Medium</option>
            <option value="200" selected="@(ViewBag.size == "200")">Large</option>
            <option value="250" selected="@(ViewBag.size == "250")">Extra Large</option>
        </select>
    </p>

    <input type="submit" value="Submit" />
</form>

<br />

@if (ViewBag.pet != null)
{
    <img src="~/img/@(ViewBag.pet).png" height="@ViewBag.size" alt="@ViewBag.pet" />
}
else
{
    <img src="~/img/pet.png" height="150" alt="Favourite Pet" />
}
