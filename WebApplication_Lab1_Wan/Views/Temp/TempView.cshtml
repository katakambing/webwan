@model WebApplication_Lab1_Wan.Models.TempModel

<h3>Temperature Converter</h3>

<form method="post" asp-action="TempView">
    <p>
        Enter temperature in Celsius:
        <input asp-for="Celsius" type="number" step="any" />
    </p>
    <p>
        <input type="submit" value="Convert" />
    </p>
</form>

<p>
    Temperature in Fahrenheit:
    @(Model != null ? Model.Fahrenheit.ToString("0.00") : "")
</p>
<p>
    Status:
    <span style="color:@(Model != null ? Model.Color.ToString() : "black")">@(Model != null ? Model.Status.ToString() : "")</span>
</p>
