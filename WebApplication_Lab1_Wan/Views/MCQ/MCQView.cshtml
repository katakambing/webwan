<h3>Multiple Choice Question App</h3>

<form asp-action="MCQView" method="post">
    <p>
        Which of the following is a server-side programming language?<br />
        <input type="radio" name="Answer" value="a" /> HTML <br />
        <input type="radio" name="Answer" value="b" /> JavaScript <br />
        <input type="radio" name="Answer" value="c" /> C# <br />
        <input type="radio" name="Answer" value="d" /> CSS <br />
        <input type="radio" name="Answer" value="e" /> AJAX <br />
    </p>
    <input type="submit" value="Submit" />
</form>

<br />

<p>
    Selected item index is: @ViewBag.IndexBag <br />
    Selected item value is: @ViewBag.AnswerBag <br />
    Selected item Text is: @ViewBag.NameBag
</p>
