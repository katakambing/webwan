@model WebApplication_ElectricityBill.Models.ElectricityModel

<h2>Electricity Bill Calculator</h2>

<form method="post" asp-action="ElectricityView">
    <div>
        <label>Units Consumed (kWh):</label><br />
        <input asp-for="UnitsConsumed" type="number" step="0.01" />
    </div>
    <br />
    <div>
        <label>Tariff Category:</label><br />
        <select asp-for="Category">
            <option value="Domestic">Domestic (Residential)</option>
            <option value="Commercial">Commercial</option>
        </select>
    </div>
    <br />
    <input type="submit" value="Calculate Bill" />
</form>

<br />

@if (Model != null)
{
    <div>
        <h3>
            Total Charges: RM @Model.TotalAmount.ToString("0.00")
        </h3>
    </div>
}
