<h3>Favourite Pet Application</h3>

<form asp-action="FavouritePetView" method="post">
    <p>
        Please select your favourite pet:<br /><br />
        <select name="pet" size="5" required>
            <option value="bird" selected="@(ViewBag.pet == "bird")">Bird</option>
            <option value="cat" selected="@(ViewBag.pet == "cat")">Cat</option>
            <option value="dog" selected="@(ViewBag.pet == "dog")">Dog</option>
            <option value="fish" selected="@(ViewBag.pet == "fish")">Fish</option>
            <option value="rabbit" selected="@(ViewBag.pet == "rabbit")">Rabbit</option>
        </select>
    </p>

    <p>
        Select image size:<br /><br />
        <select name="size">
            <option value="50" selected="@(ViewBag.size == "50")">Extra Small (50px)</option>
            <option value="100" selected="@(ViewBag.size == "100")">Small (100px)</option>
            <option value="150" selected="@(ViewBag.size == null || ViewBag.size == "150")">Medium (150px)</option>
            <option value="200" selected="@(ViewBag.size == "200")">Large (200px)</option>
            <option value="250" selected="@(ViewBag.size == "250")">Extra Large (250px)</option>
        </select>
    </p>

    <input type="submit" value="Submit" />
</form>

@if (ViewBag.pet != null)
{
    <div class="preview">
        <p>You selected: <strong>@ViewBag.pet</strong></p>
        <img src="~/img/@(ViewBag.pet).jpg" height="@ViewBag.size" alt="@ViewBag.pet" />
    </div>
}
