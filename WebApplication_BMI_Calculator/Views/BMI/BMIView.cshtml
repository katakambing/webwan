@model WebApplication_BMI_Calculator.Models.BMIModel

<h2>BMI Calculator</h2>

<form method="post" asp-action="BMIView">
    <div>
        <label>Please insert your weight (kg):</label><br />
        <input asp-for="Weight" type="text" />
    </div>
    <br />
    <div>
        <label>Please insert your height (m):</label><br />
        <input asp-for="Height" type="text" />
    </div>
    <br />
    <input type="submit" value="Calculate" />
</form>

<br />

<div>
    <h3>
        Your BMI is:
        @(Model != null ? Model.Result.ToString("0.00") : "")
    </h3>
</div>